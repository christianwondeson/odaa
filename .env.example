# Copy to .env and fill in. .env is git-ignored. NEVER commit real keys.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Optional Ethiopian-language TTS providers: gemini (default) | hasab | addis | auto
TTS_PROVIDER=gemini
HASAB_API_KEY=
HASAB_TTS_SPEAKER=
ADDIS_API_KEY=
ADDIS_TTS_VOICE=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# am = Amharic (officially supported by Gemini TTS), oro = Afaan Oromoo (experiment)
NARRATION_LANG=am
# Optional hosted Wan 2.2 / ACE-Step 1.5 fallback (instead of Kaggle notebooks)
WAVESPEED_API_KEY=
ENABLE_WAVESPEED=0
